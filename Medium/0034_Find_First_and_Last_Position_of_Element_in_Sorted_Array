/*
Approach:
This solution uses a simple linear search to find all occurrences of the
target element in the sorted array. We traverse the array from left to
right and store every index where nums[i] is equal to the target. Since
the first occurrence is added first and the last occurrence is added last,
the resulting vector contains the required starting and ending positions.
If the target does not appear in the array, we return {-1, -1}.

Time Complexity: O(n)
Space Complexity: O(k), where k is the number of occurrences of target.
*/
class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        vector<int> ans;
        for(int i=0; i<nums.size(); i++)
        {
            if(nums[i] == target)
            {
                ans.push_back(i);
                continue;
            }
        }
        if(ans.empty())
        {
            return {-1,-1};
        }
        else
        {
            return ans;
        }
    }
};
/*
Approach:
This solution uses an unordered_map to group anagrams together. For each
word, we create a key by sorting its characters. Anagrams contain the same
characters, so after sorting, they will produce the same key. We use this
key in the unordered_map and store all words having the same key in the
corresponding vector. Finally, we traverse the map and add each group of
anagrams to the answer vector.

Time Complexity: O(n * k log k), where n is the number of strings and k is
the maximum length of a string.
Space Complexity: O(n * k), for storing the grouped strings and keys.
*/
class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        unordered_map<string, vector<string>> v;
        vector<vector<string>> ans;
        string word,key;
       for(string &str : strs)
       {
          word=str;
          key=word;
          sort(key.begin(), key.end());
          v[key].push_back(word);
       }
       for(auto it:v)
       {
        ans.push_back(it.second);
       }
       
       return ans ;
    }
};